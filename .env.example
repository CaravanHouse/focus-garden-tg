# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Публичный https-адрес, где крутится этот проект (Railway, ngrok и т.п.)
WEBAPP_URL=https://your-app.up.railway.app
PORT=3000
# 1 = пускать в API без подписи Telegram (только для локальной разработки в браузере)
DEV_NO_AUTH=0
# Папка для данных. На Railway подключите Volume и укажите его путь, например /data. По умолчанию ./data
DATA_DIR=
